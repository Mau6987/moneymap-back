ENVIRONMENT=dev
# 127.0.0.1 y no localhost: el compose publica solo en IPv4 y, en Windows, localhost
# prueba primero ::1 y la conexión se queda colgada.
# La API: usuario que hereda de moneymap_app (sujeto a RLS). Lo crea db/dev/api_role.sql
DATABASE_URL=postgresql+asyncpg://moneymap_api:moneymap@127.0.0.1:5436/moneymap
# Migraciones: dueño de las tablas
MIGRATIONS_DATABASE_URL=postgresql+psycopg://moneymap:moneymap@127.0.0.1:5436/moneymap
REDIS_URL=redis://127.0.0.1:6379/0
# El worker de voz (spec 012). Lo crea db/dev/api_role.sql
WORKER_DATABASE_URL=postgresql+asyncpg://moneymap_worker_login:moneymap@127.0.0.1:5436/moneymap
# La IA propia: stt con `docker compose -f docker-compose.ai.yml up -d stt` y el
# LLM en Ollama de escritorio (ollama pull qwen3.5:4b y gemma3:4b).
STT_BASE_URL=http://127.0.0.1:8090
LLM_BASE_URL=http://127.0.0.1:11434
# El worker en Docker (docker compose up) llega a stt por la red moneymap-ai; al
# Ollama de escritorio, por la máquina.
AI_LLM_URL=http://host.docker.internal:11434
# Todas las capas del LLM en la GPU; sin él decide Ollama (ver app/core/config.py).
# LLM_NUM_GPU=99

# Firma los JWT del token de acceso. En staging y producción lo pone Secret Manager.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-o-mas

# Verificación del correo: base del link que llega por correo. Desde el
# emulador de Android la API local se ve como http://10.0.2.2:8000.
PUBLIC_BASE_URL=http://localhost:8000
# "log" escribe el link en el log de la API (solo dev). "smtp" manda de verdad:
# descomentá y completá los datos del proveedor. El paso a paso, en
# docs/credenciales.md.
EMAIL_BACKEND=log
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASSWORD=la-contraseña-de-aplicación-sin-espacios
# SMTP_STARTTLS=true
# EMAIL_FROM=tu-cuenta@gmail.com

# Ingreso con Google: el Client ID de tipo Web. El paso a paso, en
# docs/credenciales.md.
# GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com

# Ingreso con Apple: las audiencias que acepta la API, separadas por coma. El
# bundle ID de la app iOS y, si existe, el Service ID de la web. No lleva
# secretos. El paso a paso, en docs/credenciales.md.
# APPLE_CLIENT_IDS=com.moneymap.moneymapApp

# Las fotos de los comprobantes (spec 014): el S3 propio, con
# `docker compose up -d receipts`. Sin valores usa los de dev.
# RECEIPTS_ENDPOINT=localhost:9000
