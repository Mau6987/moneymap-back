# Variables de producción y staging para docker-compose.yml en Dokploy. Se
# pegan en Dokploy → Environment, que las escribe en el .env del compose. Este
# archivo es la plantilla: sin valores reales. Nunca subas uno con valores.
#
# Fuera de dev, sin las cuatro claves de abajo el despliegue no arranca.
#
# Generar cada clave (uno distinto por variable y por ambiente):
#   uv run python -c "import secrets; print(secrets.token_hex(32))"

# prod o staging. Con cualquiera de los dos la API exige SMTP y Google.
ENVIRONMENT=prod

# Base: el dueño de las tablas (solo migraciones) y el usuario de la API (con RLS).
# Solo letras y números: van dentro de la URL de conexión. POSTGRES_PASSWORD se
# aplica al crear la base: cambiarla después no cambia la clave.
POSTGRES_PASSWORD=
API_DB_PASSWORD=
# El usuario del worker de voz (spec 012), con permisos sobre las tablas de IA.
WORKER_DB_PASSWORD=

# Redis
REDIS_PASSWORD=

# Las fotos de los comprobantes (spec 014), en el servicio `receipts`. Solo
# letras y números: van dentro de un JSON. La clave, de 32 caracteres o más.
RECEIPTS_ACCESS_KEY=moneymap
RECEIPTS_SECRET_KEY=
# La IA de voz (docker-compose.ai.yml). En el mismo servidor no hace falta: el
# worker la encuentra por la red moneymap-ai. Solo si está en otro servidor, su
# IP privada (VPC o Tailscale), la misma que AI_BIND allá. Nunca una IP pública.
# AI_STT_URL=http://10.0.0.2:8090
# AI_LLM_URL=http://10.0.0.2:11434

# Firma de los tokens: 32 caracteres o más. Si cambia, se cierran todas las sesiones.
JWT_SECRET=

# El dominio de la API, con https: es la base del link de verificación del correo.
PUBLIC_BASE_URL=https://api.tudominio.com

# Correo (docs/credenciales.md)
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=

# Ingreso con Google y Apple (docs/credenciales.md)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_IDS=com.moneymap.moneymapApp

# Solo si staging y producción están en el mismo servidor: cada uno con sus
# puertos (se publican en 127.0.0.1, no hacia afuera).
# DB_PORT=5436
# REDIS_PORT=6379
# API_PORT=8000
