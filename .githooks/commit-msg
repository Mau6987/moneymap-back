#!/bin/sh
# Hook local de commit-msg: valida el formato del mensaje.
#
# El asunto va en español, en minúscula y en imperativo. El tipo y el scope
# van en inglés: el scope es el nombre del módulo del código y el tipo es
# una palabra clave que parsean las herramientas de changelog.
#
# Ver docs/engineering.md §1.2.

msg_file="$1"
first_line=$(head -1 "$msg_file")

# Los mensajes que escribe Git solo no se revisan.
case "$first_line" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|chore|docs|refactor|test|perf|build|ci)\([a-z0-9._-]+\): .{1,72}$'

if printf '%s' "$first_line" | grep -Eq "$pattern"; then
  exit 0
fi

cat <<'EOF'
commit-msg: el mensaje no sigue el formato.

  <tipo>(<scope>): <sujeto en español>

  tipos   feat fix chore docs refactor test perf build ci
  scope   el módulo del código, en inglés y en minúsculas
          iam, billing, finance, goals, planning, reports, notify, ai, ops, db
  sujeto  en español, en minúscula, en imperativo, máximo 72 caracteres

Ejemplos:
  feat(finance): agrega el CRUD de cuentas multicuenta
  fix(iam): revoca la cadena de sesiones si se reusa un refresh
  chore(db): agrega la migración de índices por usuario y fecha

Detalle en docs/engineering.md §1.2.
EOF

exit 1
