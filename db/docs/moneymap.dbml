Ref: billing.subscriptions.plan_id > billing.plans.id

Ref: billing.subscriptions.user_id > iam.users.id

Ref: billing.usage_counters.feature_key > billing.features.key

Ref: billing.usage_counters.user_id > iam.users.id

Ref: catalog.countries.currency > catalog.currencies.code

