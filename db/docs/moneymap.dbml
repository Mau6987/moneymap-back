Ref: finance.accounts.type > catalog.account_types.code

Ref: finance.accounts.user_id > iam.users.id

Ref: finance.cards.(user_id, account_id, account_type) > finance.accounts.(user_id, id, type)

Ref: finance.cards.institution_code > catalog.financial_institutions.code

Ref: finance.categories.template_key > catalog.category_templates.key

Ref: finance.categories.user_id > iam.users.id

