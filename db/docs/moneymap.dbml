Ref: billing.subscription_changes.from_price_id > billing.plan_prices.id

Ref: billing.subscription_changes.subscription_id > billing.subscriptions.id

Ref: billing.subscription_changes.to_plan_id > billing.plans.id

Ref: billing.subscription_changes.to_price_id > billing.plan_prices.id

Ref: billing.subscription_changes.user_id > iam.users.id

