TableGroup ai {
  ai.calls
  ai.models
  ai.route_changes
  ai.routes
  ai.tasks
  ai.usage_monthly
  ai.voice_entries
}

TableGroup billing {
  billing.features
  billing.payments
  billing.plan_features
  billing.plan_prices
  billing.plans
  billing.subscription_changes
  billing.subscription_events
  billing.subscriptions
  billing.usage_counters
}

TableGroup catalog {
  catalog.account_types
  catalog.category_templates
  catalog.countries
  catalog.currencies
  catalog.financial_institutions
}

TableGroup core {
  core.audit_log
  core.outbox_events
}

TableGroup finance {
  finance.accounts
  finance.cards
  finance.categories
  finance.recurring_rules
  finance.transactions
  finance.user_currencies
  finance.user_settings
}

TableGroup goals {
  goals.goal_contributions
  goals.goals
}

TableGroup iam {
  iam.auth_identities
  iam.devices
  iam.email_verifications
  iam.sessions
  iam.terms_versions
  iam.user_preferences
  iam.users
  iam.verification_tokens
}

TableGroup notify {
  notify.notification_types
  notify.notifications
  notify.preferences
}

TableGroup ops {
  ops.incident_affected_users
  ops.incident_updates
  ops.incidents
  ops.logs
}

TableGroup planning {
  planning.affordability_checks
}

TableGroup reports {
  reports.money_stories
}
