Ref: finance.recurring_rules.user_id > iam.users.id

Ref: finance.transactions.(user_id, account_id, currency) > finance.accounts.(user_id, id, currency)

Ref: finance.transactions.(user_id, category_id, kind) > finance.categories.(user_id, id, kind)

Ref: finance.transactions.(user_id, recurring_rule_id) > finance.recurring_rules.(user_id, id)

Ref: finance.transactions.(user_id, transfer_account_id, currency) > finance.accounts.(user_id, id, currency)

Ref: finance.transactions.user_id > iam.users.id

Ref: finance.user_currencies.currency > catalog.currencies.code

Ref: finance.user_currencies.user_id > iam.users.id

Ref: finance.user_settings.main_currency > catalog.currencies.code

Ref: finance.user_settings.user_id > iam.users.id

Ref: goals.goal_contributions.(user_id, goal_id) > goals.goals.(user_id, id)

Ref: goals.goal_contributions.(user_id, transaction_id) > finance.transactions.(user_id, id)

Ref: goals.goals.currency > catalog.currencies.code

Ref: goals.goals.user_id > iam.users.id

Ref: iam.auth_identities.user_id > iam.users.id

Ref: iam.devices.user_id > iam.users.id

Ref: iam.sessions.device_id > iam.devices.id

Ref: iam.sessions.replaced_by > iam.sessions.id

Ref: iam.sessions.user_id > iam.users.id

Ref: iam.user_preferences.user_id > iam.users.id

Ref: iam.users.country_code > catalog.countries.code

Ref: iam.users.terms_version > iam.terms_versions.version

Ref: iam.verification_tokens.user_id > iam.users.id

